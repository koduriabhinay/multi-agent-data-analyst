# Copy to .env and fill in. Everything here has a working default except the API key.

# Language model — leave the key blank to run in offline mode.
# Statistics and charts still work; only the written narrative is stubbed.
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6

# Or use OpenAI instead:
# OPENAI_API_KEY=
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o

# SQLite by default — no setup needed. Swap for Postgres in production.
DATABASE_URL=sqlite:///./analyst.db
# DATABASE_URL=postgresql+psycopg2://mada:mada@localhost:5432/mada

LOG_LEVEL=INFO
SQL_ECHO=false
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
